# Taskly — segredos para scripts de configuração OAuth (uso local apenas)
# Copie para .env.oauth e preencha. Este arquivo NUNCA deve ir para o git
# e estes valores NUNCA devem virar variáveis VITE_* (iriam para o bundle do browser).

# Personal Access Token: Supabase Dashboard → Account → Access Tokens (sbp_...)
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=

# Google Cloud Console → Credentials → OAuth 2.0 Client
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
