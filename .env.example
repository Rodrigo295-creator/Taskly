# Taskly — exemplo de variáveis de ambiente
# Copie para .env e preencha com os dados do Supabase (Dashboard → Settings → API).
#
# ATENÇÃO: variáveis com prefixo VITE_ são embutidas no bundle do browser (públicas).
# NUNCA coloque segredos como VITE_*:
#   - SUPABASE_SERVICE_ROLE_KEY
#   - GOOGLE_CLIENT_SECRET
#   - SUPABASE_ACCESS_TOKEN
# Segredos de OAuth/CLI ficam em .env.oauth (ignorado pelo git) — ver .env.oauth.example.

# Obrigatórias (Supabase → Settings → API)
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-publica

# Opcionais — login social (ative após configurar os providers no Supabase)
# VITE_OAUTH_GOOGLE_ENABLED=true
# VITE_OAUTH_APPLE_ENABLED=true

# Opcionais — redes sociais exibidas no app
# VITE_INSTAGRAM_URL=https://www.instagram.com/taskly
# VITE_TIKTOK_URL=https://www.tiktok.com/@taskly
